\mode<presentation>

%\setbeamerfont{institute}{series=\bfseries,size=\small}
%\setbeamerfont{date}{series=\bfseries,size=\scriptsize}
%\setbeamerfont{author}{size=\small}
%\setbeamerfont{title}{size=\huge,series=\bfseries}
%\setbeamerfont{subtitle}{series=\bfseries}

\setbeamerfont{title}{size=\Large,%
	series=\bfseries}
\setbeamerfont{author}{size=\small}
\setbeamerfont{date}{size=\footnotesize}
\setbeamerfont*{subtitle}{size=\large}
\setbeamerfont{frametitle}{size=\large,%
	series=\bfseries}

% Title page (template [lmu]): sizes of the LMU PowerPoint template x 0.4724
% (title 28 pt, subtitle/name/date 16 pt); the label in the header box is
% larger than in the template (6.8 pt x 0.4724 = 3.2 pt), so it stays readable
\setbeamerfont{title page title}{size=\fontsize{13.2}{12.5}\selectfont,%
	series=\bfseries}
\setbeamerfont{title page info}{size=\fontsize{7.56}{8.5}\selectfont,%
	series=\bfseries}
\setbeamerfont{title page institute}{size=\fontsize{6}{7.5}\selectfont,%
	series=\mdseries}
\setbeamerfont{title page label}{size=\fontsize{5}{6}\selectfont,%
	series=\bfseries}

% Section page (template [lmu])
\setbeamerfont{section page number}{size=\Huge,series=\bfseries}
\setbeamerfont{section title}{size=\LARGE,series=\bfseries}
\setbeamerfont{subsection title}{size=\large}

\setbeamerfont{enumerate item}{series=\bfseries}

\setbeamerfont{section in toc}{series=\bfseries}
\setbeamerfont{section in head/foot}{series=\bfseries,size=\normalsize}

\mode<all>
