\mode<presentation>

\RequirePackage{beamerlmucommon}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% Head & Foot Lines %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Section name, vertically centred in the wide header box drawn by the
% background (inner theme; positions in template-mm, see \lmu@u there).
% The headline itself stays 17 mm high, which sets where the frame title starts.
\defbeamertemplate*{headline}{lmu theme}{%
  \lmu@setunit
  \vbox to 17mm{%
    \vskip11.9\lmu@u
    \hbox{%
      \hskip63.3\lmu@u
      \vbox to 23\lmu@u{%
        \vfil
        \hbox{%
          \hskip7.4\lmu@u
          \usebeamercolor[fg]{section in head/foot}%
          \usebeamerfont{section in head/foot}%
          \vphantom{Ag}%
          \lmu@iftitlepage{}{\insertsection}%
        }%
        \vfil
      }%
    }%
    \vss
  }%
}

% No footline on the title page (set by the title page template, so a title
% frame with [noframenumbering] does not hide the footline of the next frame).
% Author and title on the left are scaled down if they would not fit next to
% the navigation symbols and the frame number, so the footline stays one line.
\newsavebox\lmu@footleft
\newsavebox\lmu@footright
\newdimen\lmu@footwidth
\defbeamertemplate*{footline}{lmu theme}{%
  \leavevmode%
  \lmu@iftitlepage{}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.5ex,dp=1.125ex,leftskip=.5ex,rightskip=1ex]{author in head/foot}%
    \sbox\lmu@footleft{%
      \usebeamerfont{author in head/foot}\insertshortauthor,
      \usebeamerfont{title in head/foot}\insertshorttitle}%
    \sbox\lmu@footright{%
      \raise-0.6ex\hbox{\usebeamertemplate***{navigation symbols}}%
      \ \insertframenumber/\inserttotalframenumber}%
    \lmu@footwidth=\dimexpr\paperwidth-1.5ex-\wd\lmu@footright-1em\relax
    \ifdim\wd\lmu@footleft>\lmu@footwidth
      \resizebox{\lmu@footwidth}{!}{\usebox\lmu@footleft}%
    \else
      \usebox\lmu@footleft
    \fi
    \hfill\usebox\lmu@footright
  \end{beamercolorbox}%
  }%
  \vskip0pt%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% Sidebars %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Empty sidebar: the navigation symbols are shown in the footline
\setbeamertemplate{sidebar right}{}

