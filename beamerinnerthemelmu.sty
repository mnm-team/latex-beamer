%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% Geometry %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Header and title page follow the official LMU PowerPoint template
% (lmu_ppt_vorlage_20221104.potx, 338.7 x 190.5 mm). All positions below are
% given in millimetres of that template; \lmu@u is one such millimetre scaled
% to the paper width (16:9: 160 mm / 338.7 mm = 0.4724). Font sizes are not
% scaled with the page: they are the template's sizes times 0.4724.
% Images get both width and height (in their aspect ratio), so that global
% graphicx defaults such as \setkeys{Gin}{height=\maxheight} cannot shrink them.
\newdimen\lmu@u
\def\lmu@setunit{\lmu@u=\dimexpr\paperwidth*10/3387\relax}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% Logo %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% The logo sits centred in the right header box. Replace it with
% \logo{\includegraphics[height=5mm]{yourlogo}}, or remove it with \logo{}.
\setbeamertemplate{logo}{%
  \includegraphics[width=34\lmu@u,height=14\lmu@u,keepaspectratio]{mnmlogo}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% Background %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Header: LMU logo block, a wide box (section name, see the headline in the
% outer theme) and a small box with the logo, all 23 template-mm high.
\setbeamertemplate{background}{%
  \lmu@setunit
  \begin{tikzpicture}[x=\lmu@u,y=\lmu@u,line width=0.1mm]
    \useasboundingbox (0pt,0pt) rectangle (\paperwidth,\paperheight);
    \begin{scope}[shift={(0pt,\paperheight)}]
      \node[anchor=north west,inner sep=0] at (12.4,-11.9)
        {\includegraphics[width=48.54\lmu@u,height=23\lmu@u]{lmulogogreen.png}};
      \draw[color=lmu@green] (63.3,-11.9) rectangle (277.7,-34.9);
      \draw[color=lmu@green] (280.2,-11.9) rectangle (325.9,-34.9);
      \node[anchor=center,inner sep=0] at (303.05,-23.4) {\insertlogo};
    \end{scope}
  \end{tikzpicture}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% Title & Part Pages %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Page number of the title page; the outer theme hides the section name and the
% footline there. Set by both title page templates.
\def\lmu@titlepagenumber{0}
\def\lmu@marktitlepage{\xdef\lmu@titlepagenumber{\the\c@page}}
\def\lmu@iftitlepage{%
  \ifnum\c@page=\lmu@titlepagenumber\relax
    \expandafter\@firstoftwo
  \else
    \expandafter\@secondoftwo
  \fi}

% Remember the long and the short form of \institute[short]{long}, to show the
% long form on the title page only if it differs from the short one.
\long\def\lmu@longinstitute{}
\long\def\lmu@shortinstitute{}
\let\lmu@beamer@institute\beamer@institute
\long\def\beamer@institute[#1]#2{%
  \long\def\lmu@shortinstitute{#1}%
  \long\def\lmu@longinstitute{#2}%
  \lmu@beamer@institute[#1]{#2}}

% No automatic hyphenation on the narrow title panel (explicit hyphens may break)
\def\lmu@nohyphens{\hyphenpenalty=10000\relax}

% Letter-spaced capitals if microtype provides \textls
\def\lmu@spaced#1{\ifdefined\textls\textls[80]{#1}\else#1\fi}

% Title page after the layout "Präsentationstitel" of the LMU PowerPoint
% template: green panel on the left with the title at the top and subtitle,
% author, (long) institute and date at the bottom; the short institute in
% capitals in the wide header box; the seal cut off at the bottom right.
\defbeamertemplate{title page}{lmu}{%
  \lmu@marktitlepage
  \lmu@setunit
  \begin{tikzpicture}[remember picture,overlay,x=\lmu@u,y=\lmu@u]
    \usebeamercolor{title page panel}%
    \fill[color=title page panel.bg]
      ($(current page.north west)+(0,-41.2)$) rectangle
      ($(current page.south west)+(149.3,0)$);
    \node[anchor=north west,inner sep=0] at ($(current page.south east)+(-98.4,114.3)$)
      {\includegraphics[width=123\lmu@u,height=125.06\lmu@u]{siegel}};
    \ifx\inserttitlegraphic\@empty\else
      \node[anchor=north east,inner sep=0] at ($(current page.north east)+(-12.8,-41.2)$)
        {\inserttitlegraphic};
    \fi
    \node[anchor=north west,inner sep=0,text width=125.4\lmu@u,align=left,
      text=title page panel.fg] at ($(current page.north west)+(12.3,-60.8)$)
      {\usebeamerfont{title page title}\lmu@nohyphens\inserttitle\par};
    \node[anchor=south west,inner sep=0,text width=125.4\lmu@u,align=left,
      text=title page panel.fg] at ($(current page.south west)+(12.4,11)$)
      {\usebeamerfont{title page info}\lmu@nohyphens
        \ifx\insertsubtitle\@empty\else\insertsubtitle\par\fi
        \ifx\beamer@shortauthor\@empty\else\insertauthor\par\fi
        \ifx\lmu@longinstitute\lmu@shortinstitute\else
          {\usebeamerfont{title page institute}\insertinstitute\par}\fi
        \ifx\insertdate\@empty\else\insertdate\par\fi};
    \ifx\beamer@shortinstitute\@empty\else
      \usebeamercolor{title page label}%
      \node[anchor=south west,inner xsep=2.5\lmu@u,inner ysep=1.3\lmu@u,
        text=title page label.fg] at ($(current page.north west)+(63.3,-34.9)$)
        {\usebeamerfont{title page label}\lmu@spaced{\MakeUppercase{\beamer@shortinstitute}}};
    \fi
  \end{tikzpicture}%
}

% The previous title page: title in green on white, large seal at the bottom
% right. Use it with \setbeamertemplate{title page}[classic].
\pgfdeclareimage[height=.6\paperheight]{lmu-siegel-large}{siegel}
\defbeamertemplate{title page}{classic}{%
  \lmu@marktitlepage
  \setlength{\unitlength}{\paperwidth}
  \begin{tikzpicture}[remember picture,overlay]
      % Big siegel in the bottom right corner on the title page
      \node[inner sep=0pt, anchor=south east, opacity=0.6] at ($ (current page.south east) + (4ex, -5ex) $)
    {
      \pgfuseimage{lmu-siegel-large}%
    };
  \end{tikzpicture}%
    \put(0,-0.45){%
      \begin{minipage}[b][0.85\paperheight]{\textwidth}
        \ifx\inserttitlegraphic\@empty\else\usebeamertemplate*{title graphic}\fi
        \vfill%
        \ifx\inserttitle\@empty\else\usebeamertemplate*{title}\fi
        \ifx\insertsubtitle\@empty\else\usebeamertemplate*{subtitle}\fi
        %\usebeamertemplate*{title separator}
        \ifx\beamer@shortauthor\@empty\else\usebeamertemplate*{author}\fi
        \ifx\insertinstitute\@empty\else\usebeamertemplate*{institute}\fi
        \vfill
        \ifx\insertdate\@empty\else\usebeamertemplate*{date}\fi
        \vfill
        \vspace*{1mm}
      \end{minipage}
    }%
}

\setbeamertemplate{title page}[lmu]

\def\maketitle{%
  \ifbeamer@inframe
    \titlepage
  \else
    \frame[plain,noframenumbering]{\titlepage}
  \fi
}
\def\titlepage{%
  \usebeamertemplate{title page}
}

