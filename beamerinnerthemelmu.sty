\defbeamertemplate{section page}{simple}{
  \begin{center}
    \usebeamercolor[fg]{section title}
    \usebeamerfont{section title}
    \insertsectionhead\par
    \ifx\insertsubsectionhead\@empty\else
      \usebeamercolor[fg]{subsection title}
      \usebeamerfont{subsection title}
      \insertsubsectionhead
    \fi
  \end{center}
}

% Section page: section number, section title and (if any) subsection title,
% left-aligned and vertically centred ([c] frame). \sectionpage inserts it, e.g.
%   \AtBeginSection{\begin{frame}[plain,c]\sectionpage\end{frame}}
% The centred page from before is \setbeamertemplate{section page}[simple].
\defbeamertemplate{section page}{lmu}{%
  \vfill
  \hspace*{6mm}%
  \begin{minipage}{0.85\textwidth}
    \raggedright
    {\usebeamercolor[fg]{section page number}\usebeamerfont{section page number}%
      \insertsectionnumber\par}
    \vspace{2mm}
    {\usebeamercolor[fg]{section title}\usebeamerfont{section title}%
      \insertsectionhead\par}
    \ifx\insertsubsectionhead\@empty\else
      \vspace{3mm}
      {\usebeamercolor[fg]{subsection title}\usebeamerfont{subsection title}%
        \insertsubsectionhead\par}
    \fi
  \end{minipage}
  \vfill
}
\setbeamertemplate{section page}[lmu]

